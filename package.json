{
  "name": "nanime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint --deny-warnings",
    "doctor": "react-doctor --yes --blocking warning",
    "check": "bun run typecheck && bun run lint && bun run doctor",
    "start": "bun run server/app.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.6",
    "@tanstack/react-query": "^5.102.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.29",
    "hls.js": "^1.7.1",
    "lucide-react": "^0.475.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.16.0",
    "oxlint-plugin-react-doctor": "latest",
    "react-doctor": "latest",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
