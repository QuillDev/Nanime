{
  "name": "nanime",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && NANIME_DATABASE=${TMPDIR:-/tmp}/nanime-tooling-$$.sqlite NANIME_ADMIN_SETUP_TOKEN=nanime-tooling-token-with-thirty-two-characters vite build",
    "preview": "vite preview",
    "build:packages": "bun run --cwd packages/file-manager build",
    "typecheck": "bun run build:packages && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p packages/file-manager/tsconfig.json",
    "lint": "bun run lint:plugins && oxlint --deny-warnings",
    "lint:plugins": "bun build node_modules/oxlint-plugin-anti-slop/src/index.ts --target=node --format=esm --outfile=node_modules/.cache/nanime/anti-slop.mjs && bun -e 'import source from \"oxlint-plugin-anti-slop\"; import bundled from \"./node_modules/.cache/nanime/anti-slop.mjs\"; if (source.rules === undefined || bundled.rules === undefined) process.exit(1)'",
    "doctor": "NANIME_DATABASE=${TMPDIR:-/tmp}/nanime-tooling-$$.sqlite NANIME_ADMIN_SETUP_TOKEN=nanime-tooling-token-with-thirty-two-characters react-doctor --yes --blocking warning",
    "check": "bun run typecheck && bun run lint && bun run doctor",
    "start": "bun run server/app.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nanime/file-manager": "workspace:*",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.102.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.29",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#6d53855",
    "oxlint-plugin-react-doctor": "latest",
    "react-doctor": "latest",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
