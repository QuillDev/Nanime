{
  "name": "nanime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "bun run lint:plugins && oxlint --deny-warnings",
    "lint:plugins": "bun -e 'import plugin from \"oxlint-plugin-anti-slop\"; if (plugin.rules === undefined) process.exit(1)'",
    "doctor": "react-doctor --yes --blocking warning",
    "check": "bun run typecheck && bun run lint && bun run doctor",
    "start": "bun run server/app.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.102.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.29",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#6d53855",
    "oxlint-plugin-react-doctor": "latest",
    "react-doctor": "latest",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
