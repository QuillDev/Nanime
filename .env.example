# Safe defaults bind Nanime to loopback for use behind a reverse proxy.
HOST=127.0.0.1
PORT=8096
MEDIA_DIR=/path/to/your/media
NANIME_DATABASE=/path/to/your/data/nanime.sqlite

# Generate once with: openssl rand -hex 32
# Remove this secret from the runtime environment after activating `admin`.
NANIME_ADMIN_SETUP_TOKEN=

# Required when TLS terminates at a reverse proxy.
NANIME_PUBLIC_ORIGIN=https://anime.example.com
NANIME_SECURE_COOKIES=true
NANIME_TRUST_PROXY=true

# Optional qBittorrent integration. Keep its Web UI on a private network.
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME=replace-me
QBITTORRENT_PASSWORD=replace-me

# Optional VAAPI transcoding.
HWACCEL=
VAAPI_DEVICE=/dev/dri/renderD128
