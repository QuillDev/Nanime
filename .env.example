# Safe defaults bind Nanime to loopback for use behind a reverse proxy.
HOST=127.0.0.1
PORT=8096
MEDIA_DIR=/path/to/your/media
NANIME_DATABASE=/path/to/your/data/nanime.sqlite
# Optional persistent cache root for generated trickplay preview sheets.
NANIME_CACHE_DIR=/path/to/your/data/cache

# Generate once with: openssl rand -hex 32
# Remove this secret from the runtime environment after activating `admin`.
NANIME_ADMIN_SETUP_TOKEN=

# Required when TLS terminates at a reverse proxy.
NANIME_PUBLIC_ORIGIN=https://anime.example.com
NANIME_SECURE_COOKIES=true
NANIME_TRUST_PROXY=true

# Optional AniList account linking and sign-in. Create an OAuth application at
# https://anilist.co/settings/developer with this exact redirect URL.
NANIME_ANILIST_CLIENT_ID=
NANIME_ANILIST_CLIENT_SECRET=
NANIME_ANILIST_REDIRECT_URI=https://anime.example.com/api/auth/anilist/callback
# Generate once with: openssl rand -base64 32
NANIME_TOKEN_ENCRYPTION_KEY=

# Optional qBittorrent integration. Keep its Web UI on a private network.
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Optional Android app updates: a directory holding the CI-built nanime.apk and
# android-release.json. Signed-in Android clients update themselves from it.
NANIME_ANDROID_RELEASE_DIR=

# Optional VAAPI transcoding.
HWACCEL=
VAAPI_DEVICE=/dev/dri/renderD128

# Optional background transcode concurrency (1-4). When omitted, Nanime uses
# two workers on hosts with at least 24 logical CPUs and 24 GiB RAM, otherwise one.
NANIME_TRANSCODE_WORKERS=
