{
  "name": "@nanime/file-manager",
  "version": "0.1.0",
  "description": "Host-controlled React file manager: tree, sortable/filterable columns, typed async operations, no backend assumptions.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:demo": "vite --host 127.0.0.1",
    "build:demo": "bun scripts/buildDemo.ts",
    "verify": "bun scripts/verifyDist.mjs",
    "smoke:consumer": "bun scripts/consumerSmoke.mjs",
    "check": "bun run typecheck && bun run build && bun run verify && bun run build:demo"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "8.2.2"
  }
}
